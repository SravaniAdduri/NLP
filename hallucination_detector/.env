# Environment Configuration
# Copy this file to .env and fill in the values

# HuggingFace Token (FREE - get from https://huggingface.co/settings/tokens)
HF_TOKEN=your_token_here

# LLM Provider: 'huggingface_inference' (free cloud) or 'ollama' (local)
LLM_PROVIDER=huggingface_inference
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Model Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# Ollama Configuration (Optional - for local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Vector Store Configuration
VECTOR_STORE_PATH=./data/vector_store
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# Database Configuration
DATABASE_URL=sqlite:///./data/hallucination_detector.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
STREAMLIT_PORT=8501

# Logging
LOG_LEVEL=INFO
